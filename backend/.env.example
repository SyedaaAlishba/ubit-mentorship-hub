# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in real values; never commit .env.
#
# This file is documentation: the application.yml defaults below are what the app
# uses when a variable is unset, and each one is safe for local development except
# where noted. There is no .env loader in the JVM, so export these in your shell,
# or prefix the run command (see README.md).
# ---------------------------------------------------------------------------

# --- Required for Google sign-in ------------------------------------------------
# From https://console.cloud.google.com/apis/credentials. Without these the app
# starts but /oauth2/authorization/google fails to build a redirect.
# The authorised redirect URI must be exactly:
#   http://localhost:8080/login/oauth2/code/google
# and, if the frontend is served separately in production, that origin too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Required: MongoDB ----------------------------------------------------------
# Production must use a replica set. Spring Session needs transactions to expire
# sessions correctly, and a standalone mongod cannot do that.
#   mongodb+srv://user:password@cluster.mongodb.net/ubit_mentorship_hub?retryWrites=true&w=majority
# Keep real credentials in a secret store, never in this file or in git.
MONGODB_URI=mongodb://localhost:27017/ubit_mentorship_hub

# --- Optional --------------------------------------------------------------------
# Port the API listens on. Must match the Vite dev proxy target in
# frontend/vite.config.ts.
SERVER_PORT=8080

# Browser session lifetime. A longer session is more convenient and a wider window
# for a stolen cookie.
SESSION_TIMEOUT=60m

# Set to true when serving over HTTPS. Leave false for local HTTP, or the browser
# will refuse to send the session cookie and sign-in will appear to loop.
SESSION_COOKIE_SECURE=false

# Where the browser lands after a successful Google sign-in.
# In local development: http://localhost:5173/ (default)
# In production (same-origin): https://your-domain.com/
# In production (separate frontend origin): https://your-frontend-domain.com/
APP_AUTH_POST_LOGIN_REDIRECT_URI=http://localhost:5173/

# Strategy for parsing X-Forwarded-For, X-Forwarded-Proto, X-Forwarded-Port behind reverse proxies (Nginx, Render, Railway, etc.).
# Options: 'framework' (recommended), 'native', or 'none'.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Email address of the first administrator, promoted at ACCOUNT CREATION only.
# Applies when that account is first created through Google sign-in; it can never
# re-promote an existing account, so clearing it later does not demote anyone and
# setting it later does not resurrect a demotion. Leave empty to disable.
BOOTSTRAP_ADMIN_EMAIL=

# GridFS bucket for uploaded student verification documents.
VERIFICATION_GRIDFS_BUCKET=verification_documents

# Comma-separated allowed origins. Leave EMPTY when the frontend and API share an
# origin - the Vite dev proxy, or same-origin production serving - which is the
# recommended deployment and needs no CORS at all. Only set this if the frontend is
# genuinely on a different origin, and never use "*": a wildcard with a session
# cookie is not a workable configuration.
APP_CORS_ALLOWED_ORIGINS=

# TRACE, DEBUG, INFO, WARN or ERROR.
APP_LOG_LEVEL=INFO

# --- Notes on tests -------------------------------------------------------------
# The test suite needs no MongoDB and no real Google credentials: the test
# profile supplies fake client credentials, an in-memory session repository, and
# app.mongodb.ensure-indexes=false. Run it with:
#   .\mvnw.cmd -B clean verify
# It is never necessary to set MONGODB_URI to run the tests.
